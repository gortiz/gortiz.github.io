---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.pubDate.getUTCFullYear()))].sort((a, b) => b - a);
---
<Base title="Blog" description="Technical posts by Gonzalo Ortiz.">
  <h1>Blog</h1>
  <p class="lead"><a href="/rss.xml">RSS</a> · <a href="/atom.xml">Atom</a> · <span lang="es">En español: <a href="/es/rss.xml">RSS</a> · <a href="/es/atom.xml">Atom</a></span></p>
  {posts.length === 0 && <p>No posts yet.</p>}
  {years.map((year) => (
    <>
      <h2>{year}</h2>
      <PostList posts={posts.filter((p) => p.data.pubDate.getUTCFullYear() === year)} />
    </>
  ))}
</Base>
